{
  "name": "excidian",
  "version": "0.1.1",
  "description": "View and edit Excel tables and sheets inside your Obsidian notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test test/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3"
  },
  "author": "Umberto Francesco Carolini",
  "homepage": "https://francescoumberto.github.io/ObXcel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancescoUmberto/ObXcel.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "excel",
    "xlsx"
  ]
}
